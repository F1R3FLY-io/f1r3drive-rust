// paid_transfer_factory.rho — the on-chain contract behind ADR-0002
// Paid-transfer listings.
//
// A single factory instance is deployed per listing. The factory
// holds opaque bytes (`encryptedBlob`, `kListing`) on an unforgeable
// name, and exposes a capability bundle at a registry URI that acts
// as the listing's public address. Buyers transfer REV directly
// from their own vault into a factory-owned escrow in their deploy's
// own scope; the factory then releases the blob + key on observing
// the escrow balance advance.
//
// Why this shape vs. "factory calls vault.transfer under the buyer's
// authKey"? Rholang vault authKeys are sealed to the deploy that
// newed them (AuthKey.rho + SystemVault.rho) — forwarding an
// authKey through a channel send strips its identity and the vault
// rejects it as "Invalid AuthKey". So the buyer MUST drive their
// own transfer in-scope. The factory can't ride on Bob's authority
// at all; the escrow pattern is the only clean path.
//
// Placeholders substituted at mint time by the client snippet builder:
//   {OWNER_REV}             — Alice's REV address (base58 string)
//   {OWNER_DEPLOYER_ID}     — Alice's deployer id (unforgeable name
//                             captured at mint); only she can rmdir
//                             the listing
//   {PRICE}                 — purchase price in atomic REV units
//   {ENCRYPTED_BLOB}        — client-encrypted file bytes (SELF
//                             envelope under K_listing)
//   {K_LISTING}             — raw 32-byte symmetric key (released
//                             to validated buyers so their daemon
//                             can decrypt + locally re-wrap as RECV)
//   {MINT_REPLY_CHANNEL}    — fully-qualified string name of the
//                             observation channel the mint reply
//                             fans out to (per-deploy nonce suffix).
//
// Reply shapes:
//   mint       → [true, listingUri, escrowAddress] | [false, code, msg]
//   release    → [true, encryptedBlob, kListing] | [false, code, msg]
//   rmdir      → [true] | [false, code, msg]
//
// Factory method names mirror the FUSE op the daemon invokes them
// from: `rmdir` is the on-chain half of `rmdir /<listing-uuid>/`
// on the mount surface.
//
// Listing state is a 6-tuple
//   (ownerRev, ownerDeployerId, price, blob, k, releasedCount)
// stored at `listingState` and taken+put each release so the
// released-count update is atomic.

new return,
    rl(`rho:registry:lookup`),
    insertArbitrary(`rho:registry:insertArbitrary`),
    SystemVaultCh,
    VaultAddress(`rho:vault:address`),
    factory,
    listingState,
    listingUri,
    escrowSeed,
    escrowAuthKey,
    escrowAddressCh,
    escrowAuthKeyCh,
    escrowVaultCh
in {
  rl!(`rho:vault:system`, *SystemVaultCh) |
  for (@(_, SystemVault) <- SystemVaultCh) {
    // Materialise the factory-owned escrow vault. The vault is
    // keyed to `*escrowSeed`, an unforgeable name local to this
    // mint. The factory's closure holds the seed, so later
    // `release` + `sweep` paths can authenticate against the
    // escrow in the factory's own scope — no cross-deploy authKey
    // forwarding needed.
    //
    // VaultAddress is a separate system contract (rho:vault:address)
    // that converts an unforgeable name to its canonical REV
    // address string. SystemVault.findOrCreate takes that string.
    @SystemVault!(
      "unforgeableAuthKey",
      *escrowSeed,
      *escrowAuthKeyCh
    ) |
    VaultAddress!(
      "fromUnforgeable",
      *escrowSeed,
      *escrowAddressCh
    ) |
    for (
      @authKey <- escrowAuthKeyCh;
      @escrowAddress <- escrowAddressCh
    ) {
      @SystemVault!("findOrCreate", escrowAddress, *escrowVaultCh) |
      for (@maybeEscrow <- escrowVaultCh) {
        match maybeEscrow {
          (true, escrowVault) => {
            // Seed listing state. 6-tuple so the release path can
            // atomically bump `releasedCount` with the take+put
            // pattern.
            listingState!((
              {OWNER_REV},
              {OWNER_DEPLOYER_ID},
              {PRICE},
              {ENCRYPTED_BLOB},
              {K_LISTING},
              0
            )) |

            contract factory(@method, @args, replyCh) = {
              match method {
                "escrow_address" => {
                  // Expose the escrow address so a client that
                  // only knows the listing URI can discover where
                  // to pay. The daemon stores this in the Listing
                  // record alongside the URI, so most clients
                  // won't need to call this at all.
                  replyCh!([true, escrowAddress])
                }

                "release" => {
                  // The buyer has (in their own deploy) transferred
                  // `price` REV into `escrowAddress`. We verify by
                  // checking the escrow balance has advanced by
                  // `price * (releasedCount + 1)` and, if so,
                  // bump the count + release the blob + K. The
                  // take+put on `listingState` serialises
                  // concurrent releases: a second buyer whose
                  // transfer hasn't landed yet will see the new
                  // threshold and fail with FSERR_NOT_PAID; they
                  // retry after their transfer confirms.
                  for (@st <- listingState) {
                    match st {
                      (ownerRev, ownerDeployerId, price, blob, k, released) => {
                        new balanceCh in {
                          @escrowVault!("balance", *balanceCh) |
                          for (@balance <- balanceCh) {
                            // `balance` is a `GBigInt` from the vault;
                            // `price * (released + 1)` is a `GInt`. The
                            // vault's compare op is strict on types, so
                            // coerce the right-hand side.
                            if (balance >= (price * (released + 1)).toBigInt()) {
                              listingState!((
                                ownerRev,
                                ownerDeployerId,
                                price,
                                blob,
                                k,
                                released + 1
                              )) |
                              replyCh!([true, blob, k])
                            } else {
                              listingState!(st) |
                              replyCh!([
                                false,
                                "FSERR_NOT_PAID",
                                "escrow balance below expected threshold"
                              ])
                            }
                          }
                        }
                      }
                    }
                  }
                }

                "sweep" => {
                  // Alice-only: move accumulated escrow balance to
                  // Alice's own vault. Caller forwards their
                  // deployer id (same shape as rmdir below) so we
                  // can verify owner-only without reading
                  // `rho:system:deployerId` from inside this
                  // stored body (which would resolve to the
                  // factory-publisher's id — same stored-contract
                  // gotcha as rmdir).
                  for (@(ownerRev, ownerDeployerId, _, _, _, _) <<- listingState) {
                    if (args == ownerDeployerId) {
                      new balanceCh, swResultCh in {
                        @escrowVault!("balance", *balanceCh) |
                        for (@balance <- balanceCh) {
                          @escrowVault!(
                            "transfer",
                            ownerRev,
                            balance,
                            authKey,
                            *swResultCh
                          ) |
                          for (@swResult <- swResultCh) {
                            match swResult {
                              (true, _) => replyCh!([true, balance])
                              (false, msg) =>
                                replyCh!([false, "FSERR_SWEEP_FAILED", msg])
                            }
                          }
                        }
                      }
                    } else {
                      replyCh!([false, "FSERR_PERM", "only the owner can sweep"])
                    }
                  }
                }

                "rmdir" => {
                  // Owner-only: drain `listingState` so subsequent
                  // `release` calls fail at the take step. The
                  // factory contract itself remains in the
                  // tuplespace (we can't un-publish a URI), but
                  // it's defanged — no state to release.
                  //
                  // Owner-check reads the caller's deployer id
                  // from `args` because `rho:system:deployerId`
                  // inside a stored contract body resolves to the
                  // factory-publisher's deployer, not the current
                  // invoker's. The paid_transfer_rmdir client
                  // snippet captures `*deployerId` in the
                  // caller's own deploy context and forwards it.
                  for (@(_, ownerDeployerId, _, _, _, _) <<- listingState) {
                    if (args == ownerDeployerId) {
                      for (@_ <- listingState) {
                        replyCh!([true])
                      }
                    } else {
                      for (@st <- listingState) {
                        listingState!(st) |
                        replyCh!([
                          false,
                          "FSERR_PERM",
                          "only the listing owner can rmdir"
                        ])
                      }
                    }
                  }
                }

                _ => replyCh!([false, "FSERR_UNKNOWN_METHOD", method])
              }
            } |

            // Publish the factory bundle. See earlier revision's
            // comment for the (0, bundle+{*factory}) wrapper
            // rationale — matches the lookup shape every other
            // insertSigned-stored contract uses.
            insertArbitrary!(
              (0, bundle+{*factory}),
              *listingUri
            ) |
            for (@uri <- listingUri) {
              return!([true, uri, escrowAddress]) |
              @{MINT_REPLY_CHANNEL}!([true, uri, escrowAddress])
            }
          }
          (false, msg) => {
            return!([false, "FSERR_ESCROW_INIT", msg]) |
            @{MINT_REPLY_CHANNEL}!([false, "FSERR_ESCROW_INIT", msg])
          }
        }
      }
    }
  }
}
